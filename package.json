{
  "name": "ecofoodstock",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/check-node-version.mjs",
    "dev": "node scripts/run-next.mjs dev",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "node scripts/run-next.mjs build",
    "prestart": "node scripts/check-node-version.mjs",
    "start": "node scripts/run-next.mjs start",
    "preview:mobile": "node scripts/run-next.mjs build && node scripts/run-next.mjs start -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./scripts/register-ts-tests.cjs --test tests/domain.test.ts tests/security-rpc.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration:supabase": "node --require ./scripts/register-ts-tests.cjs --test tests/supabase-integration.test.ts",
    "test:all": "npm run test && npm run test:integration:supabase",
    "security:prod-check": "node scripts/check-production-security.mjs",
    "security:deployed-check": "node scripts/check-deployed-security.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.58.0",
    "@supabase/supabase-js": "^2.45.0",
    "@zxing/browser": "^0.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  }
}
