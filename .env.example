NEXT_PUBLIC_SUPABASE_URL=your-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ECOFOODSTOCK_ENABLE_DEMO_MODE=false
# Rate-limit client IP strategy:
# auto: development uses local/proxy headers; Vercel prod auto-detects Vercel; other prod falls back to unknown.
# vercel: trust x-forwarded-for from Vercel.
# cloudflare: trust cf-connecting-ip from Cloudflare.
# trusted-proxy: trust x-forwarded-for/x-real-ip from your own trusted reverse proxy.
# none: do not trust client IP headers.
ECOFOODSTOCK_CLIENT_IP_STRATEGY=auto
# Optional production monitoring (Sentry stays disabled when no DSN is set).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Required only for source-map uploads during deployment/CI.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Redirect URIs for OAuth providers (configure in Supabase dashboard)
# Example: https://your-domain.com/auth/callback
# For local development: http://localhost:3000
